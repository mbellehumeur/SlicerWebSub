# Fly.io — Slicer WebSub MOCK auth (template)
# Copy to fly.toml and set your app name / region / VM size.
# Build context: this directory (WebSubInterface/).
#
# Deploy:
#   cd WebSubInterface/hub && python scripts/build_all_clients.py   # sync SPA mounts
#   ./deploy-fly.sh mock
#   # or: fly deploy -c fly.toml
#
# Secrets (once):
#   fly secrets set -a YOUR_HUB_APP \
#     HUB_AUTH_MODE=mock \
#     HUB_PUBLIC_BASE_URL=https://hub.example.com \
#     HUB_WS_KEEPALIVE=true
#
# Certs / DNS after first deploy:
#   fly certs add -a YOUR_HUB_APP hub.example.com
#   fly certs add -a YOUR_HUB_APP www.hub.example.com
#
# OIDC twin: fly.oidc.toml.example → fly.oidc.toml

app = "YOUR_HUB_APP"
primary_region = "iad"

[build]
  dockerfile = "hub/Dockerfile.fly"
  ignorefile = "hub/.dockerignore.fly"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

  [http_service.concurrency]
    type = "connections"
    hard_limit = 250
    soft_limit = 200

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "30s"
    method = "GET"
    path = "/api/hub/auth/config"

[[vm]]
  size = "shared-cpu-4x"
  memory = "4096mb"
