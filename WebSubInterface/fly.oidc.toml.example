# Fly.io — Slicer Hub OIDC auth (template)
# Copy to fly.oidc.toml and set your app name / region / VM size.
# Same image as fly.toml (mock); auth differs only via secrets.
#
# Deploy: ./hub/deploy-fly.sh oidc
#
# Secrets (once; IdP Regular Web Application / confidential client):
#   fly secrets set -a YOUR_HUB_OIDC_APP \
#     HUB_AUTH_MODE=oidc \
#     HUB_OIDC_ISSUER=https://YOUR_TENANT.example.com \
#     HUB_OIDC_CLIENT_ID=... \
#     HUB_OIDC_CLIENT_SECRET=... \
#     HUB_JWT_SECRET=... \
#     HUB_PUBLIC_BASE_URL=https://oidc.hub.example.com \
#     HUB_OIDC_REDIRECT_URI=https://oidc.hub.example.com/oauth/callback \
#     HUB_WS_KEEPALIVE=true
#
# IdP Allowed Callback / Logout / Web Origins: oidc.hub.example.com only.
#
# Certs / DNS:
#   fly certs add -a YOUR_HUB_OIDC_APP oidc.hub.example.com
#   # DNS: oidc CNAME → YOUR_HUB_OIDC_APP.fly.dev

app = "YOUR_HUB_OIDC_APP"
primary_region = "iad"

[build]
  dockerfile = "hub/Dockerfile.fly"
  ignorefile = "hub/.dockerignore.fly"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

  [http_service.concurrency]
    type = "connections"
    hard_limit = 250
    soft_limit = 200

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "30s"
    method = "GET"
    path = "/api/hub/auth/config"

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
